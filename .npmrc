# Skip Electron's binary download during scaffolding/CI dependency-graph checks.
# The npm package (types + entrypoints) still installs, which is all
# dependency-cruiser needs to resolve `electron` to node_modules/electron.
# Remove or override once we actually launch the shell.
ELECTRON_SKIP_BINARY_DOWNLOAD=1
# pnpm: keep the workspace strict so accidental cross-package imports fail early.
strict-peer-dependencies=false
