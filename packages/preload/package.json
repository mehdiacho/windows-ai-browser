{
  "name": "@wab/preload",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs"
  },
  "dependencies": {
    "@wab/shared": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "electron": "*"
  }
}
